{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "project_metadata": {
    "name": "JARVIS Cross-Platform AI Assistant",
    "codename": "Stark OS Mark-LXXXV",
    "version": "2.4.0",
    "description": "Cross-platform AI assistant ecosystem connecting mobile clients (iOS/Android) with real-time state synchronization, J.A.R.V.I.S. HUD voice interface, and Web Admin Panel.",
    "created_at": "2026-07-31T11:11:00Z",
    "license": "MIT"
  },
  "environment_configuration": {
    "port": 8080,
    "sync_server_url": "wss://localhost:8080/ws",
    "llm_engines": [
      {
        "provider": "Google Gemini API",
        "env_variable": "GOOGLE_GEMINI_API_KEY",
        "status": "CONFIGURED_AND_AUTHENTICATED"
      },
      {
        "provider": "Anthropic Claude API",
        "env_variable": "CLAUDE_API_KEY",
        "status": "CONFIGURED_AND_AUTHENTICATED"
      }
    ],
    "encryption": {
      "algorithm": "AES-256-GCM",
      "end_to_end": true,
      "auth_type": "OAuth 2.0 + JWT"
    }
  },
  "srs_specification": {
    "document_title": "Software Requirements Specification for Jarvis Ecosystem",
    "target_latency_ms": 150,
    "subsystems": [
      {
        "name": "Jarvis Mobile Client",
        "platforms": ["Android 10+", "iOS 15+"],
        "responsibilities": ["Voice & text input", "Context gathering", "Background state sync"]
      },
      {
        "name": "Jarvis Real-Time Sync Engine",
        "protocol": "WebSocket / gRPC",
        "latency_ms": 42,
        "conflict_resolution": "CRDT"
      },
      {
        "name": "Jarvis Web Admin Panel",
        "features": ["Control Dashboard", "Live Sync Stream", "Mobile Node Manager", "Holographic Voice HUD", "JSON Studio"]
      }
    ],
    "user_roles": ["Super Administrator", "System Operator", "Mobile Client User"]
  },
  "registered_mobile_nodes": [
    {
      "node_id": "node-m1",
      "device_name": "Alex's iPhone 15 Pro",
      "platform": "iOS 17.4",
      "ip_address": "192.168.1.104",
      "status": "online",
      "sync_state": "In Sync",
      "battery_level": "88%"
    },
    {
      "node_id": "node-m2",
      "device_name": "Work Pixel 8 Pro",
      "platform": "Android 14",
      "ip_address": "192.168.1.112",
      "status": "syncing",
      "sync_state": "Syncing Tasks",
      "battery_level": "64%"
    },
    {
      "node_id": "node-m3",
      "device_name": "Jarvis Mobile Node #3",
      "platform": "Android 13",
      "ip_address": "10.0.4.88",
      "status": "online",
      "sync_state": "Idle / Listening",
      "battery_level": "95%"
    }
  ],
  "qa_voice_history": [
    {
      "question": "How is the cross-platform sync working, Jarvis?",
      "answer": "Good day, Sir. All 3 mobile nodes are synchronized with sub-42ms latency and AES-256 encryption active.",
      "timestamp": "2026-07-31T11:10:00Z"
    }
  ],
  "payload_schemas": {
    "sync_event": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string" },
        "origin_node": { "type": "string" },
        "event_type": { "type": "string", "enum": ["TASK_MUTATION", "TELEMETRY", "NOTIFY", "VOICE_CMD"] },
        "payload": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["event_id", "origin_node", "event_type", "timestamp"]
    }
  }
}
